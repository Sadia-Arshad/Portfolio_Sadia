# Supabase - client review system
#
# Copy this file to .env.local for local development. Vite only exposes
# variables that start with VITE_, and it inlines them into the browser bundle
# at build time, so anything here is public by design.
#
# NEVER put a secret or service-role key in this file. The publishable key is
# safe in the browser because Row Level Security decides what it can read and
# write. A service-role key bypasses RLS entirely.

VITE_SUPABASE_URL=https://kmounixinbucmmywlwwt.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=sb_publishable_i6MXbLFR4t_YoGPQZ9sO-A_cJ9MEJmV
